{
  "name": "embed-club",
  "version": "1.0.1",
  "description": "Embed Club website — Next.js 16 frontend with a Payload 3 CMS backend",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" pnpm run migrate && pnpm run generate:importmap && next build --webpack",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation USE_S3_STORAGE=true tsx scripts/generateImportMap.ts",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/migrate.ts",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "biome check --write .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "create:admin": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/createBackupAdmin.ts",
    "seed:demo": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seedDemo.ts",
    "drive:auth": "node scripts/getDriveRefreshToken.mjs",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit",
    "check:ci": "biome check .",
    "build:app": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "verify": "pnpm run check:ci && pnpm run typecheck && pnpm run test:int",
    "verify:full": "pnpm run verify && pnpm run build:app && pnpm run test:e2e",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=--no-deprecation pnpm exec playwright test",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@base-ui-components/react": "1.0.0-beta.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@gsap/react": "^2.1.2",
    "@lezer/highlight": "^1.2.5",
    "@microbit/microbit-connection": "1.0.0",
    "@microbit/microbit-fs": "0.10.1",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-import-export": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@vercel/analytics": "^2.0.1",
    "blockly": "13.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "6.0.2",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.14.2",
    "gsap": "^3.15.0",
    "ioredis": "^6.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.553.0",
    "mermaid": "^11.17.2",
    "motion": "^12.43.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "react-use-measure": "^2.1.7",
    "sharp": "0.35.5",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "1.56.1",
    "@testing-library/react": "16.3.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.6.1",
    "jsdom": "26.1.0",
    "playwright": "1.56.1",
    "playwright-core": "1.56.1",
    "postcss": "^8.5.29",
    "sass": "^1.105.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^3.4.19",
    "three": "^0.186.1",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": ["sharp", "esbuild", "unrs-resolver"],
    "overrides": {
      "undici@7": "^7.29.1",
      "tinypool": "^2.1.2"
    }
  }
}
